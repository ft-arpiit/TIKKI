# ---------- Core ----------
TIKKI_NAME=TIKKI
LOG_LEVEL=INFO

# ---------- Gemini visual grounding ----------
# Leave empty for completely local-only operation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash
GEMINI_MAX_RETRIES=3
GEMINI_BASE_BACKOFF=0.5

# ---------- Screen ----------
SCREEN_MONITOR=primary
SCREEN_MAX_WIDTH=1920
SCREEN_MAX_HEIGHT=1080
SCREEN_CAPTURE_SCALE=1.0

# ---------- STT ----------
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en
WHISPER_CPU_THREADS=12
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SECONDS=0.25
AUDIO_MAX_LISTEN_SECONDS=8
AUDIO_SILENCE_SECONDS=1.0
AUDIO_START_RMS=0.012

# ---------- Voice loop ----------
REQUIRE_WAKE_WORD=true
WAKE_WORD=tikki

# ---------- TTS ----------
TTS_BACKEND=pyttsx3
TTS_RATE=185
TTS_VOLUME=0.9
TTS_VOICE=

# ---------- PyAutoGUI ----------
PAUSE_SECONDS=0.03
FAILSAFE=true
CLICK_INTERVAL=0.03
MAX_TYPE_CHARS=2000
MAX_SCROLL_UNITS=12

# ---------- Apps ----------
# JSON object: alias -> executable/path/URI.
APP_ALIASES={"notepad":"notepad.exe","calculator":"calc.exe","terminal":"wt.exe","file explorer":"explorer.exe","explorer":"explorer.exe","chrome":"chrome.exe","edge":"msedge.exe"}
